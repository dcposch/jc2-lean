/-! ## Branch packets of the `ξ` integral bridge -/

section BridgeXiPackets810

variable {k : Type*} [Field k] [CharZero k]

/-- Left-branch packet: the full retained left packet of the `ν`
integral bridge, reused opaquely — third/second-defect reductions, the
tenth-face fourth- through seventh-defect loads, the divisibility
ladder, the `F₁ ∨ F₂` alternative, the retained `m₁/τ₁/g₁/k₁`
next-order laws, and the `μ` and `ν` left residuals — together with
the new `ξ` left residual. -/
def bridgeXiLeftPacket810 (p q : k[X][X]) (h0 : k[X]) (lambda a : k)
    (t0 v0 u0 s0 w0 v1 s1 u1 w1 b62 : k[X]) : Prop :=
  bridgeNuLeftPacket810 p q h0 lambda a t0 v0 u0 s0 w0 v1 s1 u1 w1
      b62 ∧
    bridgeXiLeftResidual810 (t0.eval a) (v1.eval a) (u1.eval a)
      (b62.eval a) = 0

/-- Right-branch packet: the full retained right packet of the `ν`
integral bridge, reused opaquely — the collapsed zero jet, its
divisibility upgrades, the `ν` alternative `h₀² ∣ p₄ ∨ h₀² ∣ q₅`, and
both retained sibling/complementary sub-branches with their witness
laws — together with the depth-two jet witnesses, the new ten-term
right residual law at the root, and the strictly deeper refined
alternative `h₀² ∣ q₅ ∨ (h₀² ∣ p₄ ∧ h₀⁴ ∣ p₅)`. -/
def bridgeXiRightPacket810 (p q : k[X][X]) (h0 : k[X]) (lambda a : k)
    (t0 v0 u0 s0 w0 v1 s1 u1 w1 b62 : k[X]) : Prop :=
  bridgeNuRightPacket810 p q h0 lambda a t0 v0 u0 s0 w0 v1 s1 u1 w1
      b62 ∧
    ∃ t1 v2 u2 s2 w2 b63 a41 b51 : k[X],
      t0 = h0 * t1 ∧ v1 = h0 * v2 ∧ u1 = h0 * u2 ∧ s1 = h0 * s2 ∧
        w1 = h0 * w2 ∧ b62 = h0 * b63 ∧ p.coeff 4 = h0 * a41 ∧
        q.coeff 5 = h0 * b51 ∧
        bridgeXiRightResidual810 (t1.eval a) (v2.eval a) (u2.eval a)
            (s2.eval a) (w2.eval a) (b63.eval a) (a41.eval a)
            (b51.eval a) ((p.coeff 3).eval a) ((q.coeff 4).eval a) =
          0 ∧
        (h0 ^ 2 ∣ q.coeff 5 ∨
          (h0 ^ 2 ∣ p.coeff 4 ∧ h0 ^ 4 ∣ p.coeff 5))

end BridgeXiPackets810

