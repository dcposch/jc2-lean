/-- On the seventeenth-face jet the cleared `ξ` defect factors exactly
as `h⁸⁴` times its order-`84` head plus `h` times the tail. -/
theorem localClearedFourteenthDefect810_jet_factored
    (h t0 v1 u1 s1 w1 b62 a4 a3 a2 a1 a0 b5 b4 b3 b2 b1 : k[X])
    (lambda : k) :
    localClearedFourteenthDefect810 h (h ^ 6 * t0) (h ^ 4 * v1)
        (h ^ 2 * u1) a4 a3 a2 a1 a0 (h ^ 6 * s1) (h ^ 4 * w1)
        (h ^ 2 * b62) b5 b4 b3 b2 b1 lambda =
      h ^ 84 *
        (bridgeXiJetHead810 t0 v1 u1 s1 w1 b62 a4 b5 +
          h * bridgeXiJetTail810 h t0 v1 u1 s1 w1 b62 a4 a3 a2 a1 a0 b5
            b4 b3 b2 b1 (Polynomial.C lambda)) := by
  simp only [localClearedFourteenthDefect810, bridgeXiJetHead810,
    bridgeXiJetTail810]
  ring

