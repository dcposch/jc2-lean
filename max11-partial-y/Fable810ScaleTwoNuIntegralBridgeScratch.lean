/-! ## Factored jet peels of the cleared `ν` defect -/

section BridgeNuJetFactor810

variable {k : Type*} [Field k] [CharZero k]

set_option maxHeartbeats 400000000 in
/-- On the seventeenth-face jet the cleared `ν` defect factors exactly
as `h⁷⁸` times its order-`78` head plus `h` times the tail. -/
theorem localClearedThirteenthDefect810_jet_factored
    (h t0 v1 u1 s1 w1 b62 a4 a3 a2 a1 a0 b5 b4 b3 b2 b1 : k[X])
    (lambda : k) :
    localClearedThirteenthDefect810 h (h ^ 6 * t0) (h ^ 4 * v1)
        (h ^ 2 * u1) a4 a3 a2 a1 a0 (h ^ 6 * s1) (h ^ 4 * w1)
        (h ^ 2 * b62) b5 b4 b3 b2 b1 lambda =
      h ^ 78 *
        (bridgeNuJetHead810 t0 v1 u1 s1 w1 b62 a4 b5 +
          h * bridgeNuJetTail810 h t0 v1 u1 s1 w1 b62 a4 a3 a2 a1 a0 b5
            b4 b3 b2 b1 (Polynomial.C lambda)) := by
  simp only [localClearedThirteenthDefect810, bridgeNuJetHead810,
    bridgeNuJetTail810]
  ring

/-- Evaluation commutes with the order-`78` head. -/
theorem bridgeNuJetHead810_eval
    (t0 v1 u1 s1 w1 b62 a4 b5 : k[X]) (x : k) :
    (bridgeNuJetHead810 t0 v1 u1 s1 w1 b62 a4 b5).eval x =
      bridgeNuJetHead810 (t0.eval x) (v1.eval x) (u1.eval x)
        (s1.eval x) (w1.eval x) (b62.eval x) (a4.eval x) (b5.eval x) := by
  simp only [bridgeNuJetHead810, Polynomial.eval_add, Polynomial.eval_sub,
    Polynomial.eval_neg, Polynomial.eval_mul, Polynomial.eval_pow,
    Polynomial.eval_ofNat]

set_option maxHeartbeats 400000000 in
/-- On the collapsed right jet the peeled `ν` defect acquires three
further `h` orders and its quotient head is the single monomial
`-54975581388800 a₄₁² b₅₁`. -/
theorem bridgeNuRight_quotient_factored810
    (h t1 v2 u2 s2 w2 b63 a41 a3 a2 a1 a0 b51 b4 b3 b2 b1 : k[X])
    (lambda : k) :
    bridgeNuJetHead810 (h * t1) (h * v2) (h * u2) (h * s2) (h * w2)
        (h * b63) (h * a41) (h * b51) +
      h * bridgeNuJetTail810 h (h * t1) (h * v2) (h * u2) (h * s2)
        (h * w2) (h * b63) (h * a41) a3 a2 a1 a0 (h * b51) b4 b3 b2 b1
        (Polynomial.C lambda) =
      h ^ 3 *
        (-(54975581388800 : k[X]) * a41 ^ 2 * b51 +
          h * bridgeNuRightTail810 h t1 v2 u2 s2 w2 b63 a41 a3 a2 a1 a0
            b51 b4 b3 b2 b1 (Polynomial.C lambda)) := by
  simp only [bridgeNuJetHead810, bridgeNuJetTail810, bridgeNuRightTail810]
  ring

