/-- Exact literal row-one load at coefficient `4`. -/
theorem cubicLoadRowOnePolynomial68_coeff_four_ordinaryOneEighty68
    (alpha gamma epsilon zeta eta : k) (A B c d e : k[X])
    (hA : A.natDegree ≤ 4) (hB : B.natDegree ≤ 0)
    (hc : c.natDegree ≤ 2) (hd : d.natDegree ≤ 1)
    (he : e.natDegree ≤ 3) :
    (cubicLoadRowOnePolynomial68 0 alpha 0 gamma 0 epsilon zeta eta
      A B c ((1 / 3 : k) • (A * B) + d) e).coeff 4 =
      4 * gamma * A.coeff 2 * e.coeff 3 +
        (8 / 3 : k) * gamma * A.coeff 3 * e.coeff 2 +
        (4 / 3 : k) * gamma * A.coeff 4 * e.coeff 1 +
        (4 / 3 : k) * epsilon * A.coeff 3 * c.coeff 2 +
        (2 / 3 : k) * epsilon * A.coeff 4 * c.coeff 1 := by
  let D0 : k[X] := (1 / 3 : k) • (A * B) + d
  let Ur : k[X] := (2 / 3 * gamma : k) • B + C zeta
  have hloadEq :
      cubicLoadRowOnePolynomial68 0 alpha 0 gamma 0 epsilon zeta eta
        A B c D0 e =
      Ur * derivative D0 +
        (4 / 3 * gamma : k) • (A * derivative e - c * derivative c) +
        (2 / 3 * epsilon : k) • (A * derivative c) +
        (2 * epsilon : k) • derivative e -
        (2 / 3 * gamma : k) • (D0 * derivative B) := by
    apply (FaithfulSMul.algebraMap_injective k[X] (RatFunc k))
    simp only [cubicLoadRowOnePolynomial68, cubicLoadTPolynomial68,
      cubicLoadUPolynomial68, cubicLoadVPolynomial68, D0, Ur,
      zero_mul, zero_smul, smul_zero, add_zero, zero_add, sub_zero,
      derivative_add, derivative_sub, derivative_mul, derivative_pow,
      derivative_smul, derivative_C, one_mul, Polynomial.smul_eq_C_mul,
      map_add, map_sub, map_mul, map_pow, map_neg, map_zero,
      RatFunc.algebraMap_C, map_div₀, map_ofNat, map_natCast, map_one]
    ring
  have hD : D0.natDegree ≤ 4 := by simp only [D0]; compute_degree; omega
  have hUr : Ur.natDegree ≤ 0 := by simp only [Ur]; compute_degree; omega
  have hlow1 : (Ur * derivative D0).natDegree < 4 := by
    compute_degree
    omega
  have hAe : (A * derivative e).coeff 4 =
      3 * A.coeff 2 * e.coeff 3 + 2 * A.coeff 3 * e.coeff 2 +
        A.coeff 4 * e.coeff 1 := by
    have hA5 : A.coeff 5 = 0 :=
      coeff_eq_zero_of_natDegree_lt (hA.trans_lt (by norm_num))
    have he4 : e.coeff 4 = 0 :=
      coeff_eq_zero_of_natDegree_lt (he.trans_lt (by norm_num))
    have he5 : e.coeff 5 = 0 :=
      coeff_eq_zero_of_natDegree_lt (he.trans_lt (by norm_num))
    have h := mul_coeff_four_oneTwentyOrdinaryNonzeroNext68 A (derivative e)
    norm_num [coeff_derivative, hA5, he4, he5] at h
    linear_combination h
  have hAc : (A * derivative c).coeff 4 =
      2 * A.coeff 3 * c.coeff 2 + A.coeff 4 * c.coeff 1 := by
    have hA5 : A.coeff 5 = 0 :=
      coeff_eq_zero_of_natDegree_lt (hA.trans_lt (by norm_num))
    have hc3 : c.coeff 3 = 0 :=
      coeff_eq_zero_of_natDegree_lt (hc.trans_lt (by norm_num))
    have hc4 : c.coeff 4 = 0 :=
      coeff_eq_zero_of_natDegree_lt (hc.trans_lt (by norm_num))
    have hc5 : c.coeff 5 = 0 :=
      coeff_eq_zero_of_natDegree_lt (hc.trans_lt (by norm_num))
    have h := mul_coeff_four_oneTwentyOrdinaryNonzeroNext68 A (derivative c)
    norm_num [coeff_derivative, hA5, hc3, hc4, hc5] at h
    linear_combination h
  have hlowc : (c * derivative c).natDegree < 4 := by compute_degree; omega
  have hlowe : (derivative e).natDegree < 4 := by compute_degree; omega
  have hderB : derivative B = 0 := derivative_eq_zero.mpr (by omega)
  change (cubicLoadRowOnePolynomial68 0 alpha 0 gamma 0 epsilon zeta eta
      A B c D0 e).coeff 4 = _
  rw [hloadEq]
  simp only [hderB, mul_zero, zero_smul, sub_zero, coeff_add, coeff_sub,
    coeff_smul, coeff_zero, smul_eq_mul, hAe, hAc,
    coeff_eq_zero_of_natDegree_lt hlow1,
