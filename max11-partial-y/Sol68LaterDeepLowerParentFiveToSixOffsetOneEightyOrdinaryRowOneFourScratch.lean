relations. -/
theorem fiveToSix_ordinaryOneEighty_rowOneFour_shadow68
    (a a₃ b c₁ c₂ d₀ d₁ e₂ e₃ : k)
    (hb : b ≠ 0) (hcTop : c₂ ≠ 0)
    (hface : b * e₃ + c₂ * d₁ = 0)
    (hdisc : a * b ^ 2 + 3 * c₂ ^ 2 = 0)
    (hedge : 9 * e₃ ^ 2 - 4 * c₂ ^ 3 = 0)
    (hT1 : a₃ * b ^ 2 + 6 * c₁ * c₂ = 0)
    (hT2 : 2 * c₂ * d₀ - c₁ * d₁ = 0)
    (hT3 : 2 * b * e₂ + 3 * c₁ * d₁ = 0) :
    2 * a₃ * b ^ 2 * c₂ - 3 * a₃ * d₁ ^ 2 +
      2 * a * b ^ 2 * c₁ - 6 * a * d₀ * d₁ -
      6 * c₁ * c₂ ^ 2 + 18 * e₂ * e₃ = 0 := by
  have hpins : c₂ ^ 2 * (4 * b ^ 2 * c₂ - 9 * d₁ ^ 2) = 0 := by
    linear_combination (-(b ^ 2)) * hedge +
      (9 * (b * e₃ - c₂ * d₁)) * hface
  have hpin : 4 * b ^ 2 * c₂ - 9 * d₁ ^ 2 = 0 :=
    (mul_eq_zero.mp hpins).resolve_left (pow_ne_zero 2 hcTop)
  have hscaled : b ^ 2 * c₂ *
      (2 * a₃ * b ^ 2 * c₂ - 3 * a₃ * d₁ ^ 2 +
        2 * a * b ^ 2 * c₁ - 6 * a * d₀ * d₁ -
        6 * c₁ * c₂ ^ 2 + 18 * e₂ * e₃) = 0 := by
    linear_combination
      (-2 * b ^ 2 * c₂ ^ 2 - 6 * b * d₁ * e₃) * hT1 +
      (2 * b ^ 2 * c₂ * c₁ + 6 * b * d₀ * e₃) * hdisc -
      (9 * b * c₂ * e₃) * hT2 +
      (9 * b * c₂ * e₃) * hT3 +
      (-6 * a * b ^ 2 * d₀ + 6 * a₃ * b ^ 2 * d₁) * hface +
      (a₃ * b ^ 2 * c₂) * hpin
  have hb2 : b ^ 2 ≠ 0 := pow_ne_zero 2 hb
  have hbc : b ^ 2 * c₂ ≠ 0 := mul_ne_zero hb2 hcTop
  exact (mul_eq_zero.mp hscaled).resolve_left hbc

