/-- Cancellation of the literal I3 loads in row-one coefficient `4`. -/
theorem fiveToSix_ordinaryOneEighty_rowOneFour_reduced68
    (a₂ a₃ a₄ b c₁ c₂ d₀ d₁ e₁ e₂ e₃ gamma epsilon
      J₁ J₂ J₃ : k)
    (hJ1 : J₁ + 2 * epsilon * c₁ + 4 * gamma * e₁ = 0)
    (hJ2 : J₂ + 2 * epsilon * c₂ + 4 * gamma * e₂ = 0)
    (hJ3 : J₃ + 4 * gamma * e₃ = 0)
    (hrow : (1 / 27 : k) *
        (27 * a₂ * J₃ + 18 * a₃ * J₂ + 40 * a₃ * b ^ 2 * c₂ -
          60 * a₃ * d₁ ^ 2 + 9 * a₄ * J₁ + 40 * a₄ * b ^ 2 * c₁ -
          120 * a₄ * d₀ * d₁ - 120 * c₁ * c₂ ^ 2 +
          360 * e₂ * e₃) +
        4 * gamma * a₂ * e₃ + (8 / 3 : k) * gamma * a₃ * e₂ +
        (4 / 3 : k) * gamma * a₄ * e₁ +
        (4 / 3 : k) * epsilon * a₃ * c₂ +
        (2 / 3 : k) * epsilon * a₄ * c₁ = 0) :
    2 * a₃ * b ^ 2 * c₂ - 3 * a₃ * d₁ ^ 2 +
      2 * a₄ * b ^ 2 * c₁ - 6 * a₄ * d₀ * d₁ -
      6 * c₁ * c₂ ^ 2 + 18 * e₂ * e₃ = 0 := by
  linear_combination (27 / 20 : k) * hrow -
    (27 / 20 : k) * a₂ * hJ3 -
    (9 / 10 : k) * a₃ * hJ2 -
    (9 / 20 : k) * a₄ * hJ1

