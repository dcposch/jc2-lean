                (149105578800 : K[X]) * p.coeff 6 * g2 ^ 12 +
                (1073560167360 : K[X]) * p.coeff 6 ^ 2 * g2 ^ 10 -
                (4005462686720 : K[X]) * p.coeff 6 ^ 3 * g2 ^ 8 +
                (8193143439360 : K[X]) * p.coeff 6 ^ 4 * g2 ^ 6 -
                (8889633865728 : K[X]) * p.coeff 6 ^ 5 * g2 ^ 4 +
                (4461711851520 : K[X]) * p.coeff 6 ^ 6 * g2 ^ 2 -
                (697596641280 : K[X]) * p.coeff 6 ^ 7) =
            H ^ 2 *
              alignedFifteenthNonsquareCof810 H g2 (p.coeff 0)
                (p.coeff 1) (p.coeff 2) (p.coeff 3) (p.coeff 4)
                (p.coeff 5) (p.coeff 6) (q.coeff 1) (q.coeff 2)
                (q.coeff 3) (q.coeff 4) (q.coeff 5) (q.coeff 6) κ ∧
          (∀ a : K, H.eval a = 0 →
            g2.eval a = 0 ∧ (p.coeff 6).eval a = 0) ∧
          H ∣ g2 ∧ H ∣ p.coeff 6) := by
  dsimp only at haligned ⊢
  by_cases hsq : ∃ h0 : K[X], H = h0 ^ 2
