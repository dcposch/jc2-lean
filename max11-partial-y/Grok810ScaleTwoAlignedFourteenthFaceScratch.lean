/-- Squared weight-one-hundred-five polynomial first integral of the
aligned `(8,10)` fifteenth defect: `N₁₅² = κ₁₄ H¹⁰⁵`.  The exponent is
odd, so the integral is chambered. -/
theorem alignedFifteenthDefectPowerRelation_810 {K : Type*}
    [Field K] [CharZero K] {p q : K[X][Y]} {j : K} {H : K[X]} {κ : K}
    (hp : p.natDegree = 8) (hq : q.natDegree = 10)
    (hjac : bivariateJacobian p q = Polynomial.C (Polynomial.C j))
    (hH : H ≠ 0)
    (hp8 : p.coeff 8 = H ^ 4) (hq10 : q.coeff 10 = H ^ 5)
    (haligned :
      (5 : K[X]) * p.coeff 7 * H - (4 : K[X]) * q.coeff 9 = 0)
    (hM : alignedSecondDefect810 H (p.coeff 6) (p.coeff 7) (q.coeff 8) =
      Polynomial.C κ * H ^ 7) :
    ∃ κ₁₄ : K,
      alignedFifteenthDefect810 H (p.coeff 0) (p.coeff 1) (p.coeff 2)
          (p.coeff 3) (p.coeff 4) (p.coeff 5) (p.coeff 6) (p.coeff 7)
          (q.coeff 1) (q.coeff 2) (q.coeff 3) (q.coeff 4) (q.coeff 5)
          (q.coeff 6) (q.coeff 7) κ ^ 2 =
        Polynomial.C κ₁₄ * H ^ 105 := by
  let N : K[X] :=
    alignedFifteenthDefect810 H (p.coeff 0) (p.coeff 1) (p.coeff 2)
      (p.coeff 3) (p.coeff 4) (p.coeff 5) (p.coeff 6) (p.coeff 7)
      (q.coeff 1) (q.coeff 2) (q.coeff 3) (q.coeff 4) (q.coeff 5)
      (q.coeff 6) (q.coeff 7) κ
  have hrow :
      (2 : K[X]) * H * N.derivative -
        (105 : K[X]) * N * H.derivative = 0 := by
    simpa only [N] using
      alignedFifteenthDefectRow_eq_zero_810 hp hq hjac hp8 hq10
        haligned hM
  have hC105 : Polynomial.C (105 : K) = (105 : K[X]) := C_ofNat_poly
  have hC2 : Polynomial.C (2 : K) = (2 : K[X]) := C_ofNat_poly
  have hW : Polynomial.wronskian (N ^ 2) (H ^ 105) = 0 := by
    rw [Polynomial.wronskian, Polynomial.derivative_pow,
      Polynomial.derivative_pow]
    calc
      N ^ 2 * (Polynomial.C (105 : K) * H ^ (105 - 1) * H.derivative) -
          Polynomial.C (2 : K) * N ^ (2 - 1) * N.derivative * H ^ 105 =
          N * H ^ 104 *
            (Polynomial.C (105 : K) * N * H.derivative -
              Polynomial.C (2 : K) * H * N.derivative) := by
        ring
      _ = 0 := by
        rw [hC105, hC2]
        have hfac :
            (105 : K[X]) * N * H.derivative -
              (2 : K[X]) * H * N.derivative = 0 := by
          linear_combination -hrow
        rw [hfac, mul_zero]
  exact eq_C_mul_of_wronskian_eq_zero (pow_ne_zero 105 hH) hW

