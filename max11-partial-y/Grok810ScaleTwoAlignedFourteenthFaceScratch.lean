import Fable810ScaleTwoAlignedThirteenthFaceScratch
import Grok810DegreeZeroRowScratch

/-! # Fourteenth aligned face row for the normalized `(8,10)` scale-two leaf

Untracked working note.  No tracked file was edited.

`Fable810ScaleTwoAlignedThirteenthFaceScratch` consumed the degree-`3`
aligned Keller row (the chamber-free `N₁₄ = κ₁₃ H⁴⁹`).  This file
consumes the next unused aligned row, the degree-`2` Jacobian
coefficient (internal names `alignedFifteenth*`).

At the common source level, modulo the face `N = 5 p₇ H - 4 q₉ = 0`
and the consumed degree-`15` through degree-`3` tower, the degree-`2`
row is the weighted derivative of the weight-one-hundred-five defect
`N₁₅` (the raise-by-seven of `N₁₄`: each monomial is either multiplied
by `p₇` or has one index shifted down against `H⁴`).  The defect is
`q₀`-free — the weight-105 `q₀`-ansatz monomials solve to zero — and
`q₀` enters the multiplier identity only through the `N₁₀`-row
correction.  On the aligned face every right-hand correction vanishes,
so `2 H N₁₅' = 105 N₁₅ H'` and the squared first integral

`N₁₅² = κ₁₄ H¹⁰⁵`

holds for a preserved constant `κ₁₄`.  The exponent is odd, so the
integral is **chambered**:

* square chamber `H = h₀²`, `p₇ = h₀⁴ g₁`: `N₁₅ = ν₆ h₀¹⁰⁵` with
  `ν₆² = κ₁₄`; peeling `h₀⁶⁰` and consuming the previous factored
  quotient (`128 q₇ h₀²` solved) leaves the cleared fifteenth row
  against `ν₆ h₀⁴⁵`, with factored transport
  `456 g₁ (8394412915 g₁¹⁴ - 149105578800 p₆ g₁¹² + ⋯ - 697596641280 p₆⁷)
  = h₀⁴ (co-factor - ν₆ h₀⁴¹)`.
* nonsquare chamber: the odd exponent forces `κ₁₄ = 0` and `N₁₅ ≡ 0`.
  With `p₇ = H² g₂`, peeling `H³⁰` leaves the cleared fifteenth row
  equal to zero and the same pentadecic transport against `H² ·`
  co-factor.

The root pentadecic is absorbed by the degree-`13` collapse
`g(a) = 0 ∧ p₆(a) = 0`.  The chamber-independent root jet stays
`p₇, q₉, q₈, p₆`.  No closure is claimed.  Both chambers remain open
where not forced (`κ₁₄ = 0` and `N₁₅ ≡ 0` in the nonsquare chamber
only).  The next unused Keller row is the degree-`1` Jacobian
coefficient (weight-one-hundred-twelve defect, even exponent, hence
chamber-free).  The eventual degree-`0` inhomogeneous Keller row
`p₀' q₁ - p₁ q₀' = C j` is recorded from
`degreeZeroCoefficientJacobianRow_810` but is not consumed.  No
total-degree or twice-prime theorem is used, and no finite-root
shortcut is taken.
-/

open scoped Polynomial.Bivariate

noncomputable section

open MvPolynomial Polynomial

namespace Max11DegreeRoutes

set_option maxRecDepth 1000000
set_option linter.unusedVariables false

/-! ## Literal degree-`2` Keller coefficient on the aligned face -/

/-- The fifteenth row below the leading weighted-Wronskian row for
outer degrees `(8,10)`: the degree-`2` Jacobian coefficient. -/
theorem alignedFifteenthCoefficientJacobianRow_810 {K : Type*}
    [Field K] [CharZero K] {p q : K[X][Y]} {j : K}
    (hp : p.natDegree = 8) (hq : q.natDegree = 10)
    (hjac : bivariateJacobian p q = Polynomial.C (Polynomial.C j)) :
    (p.coeff 2).derivative * q.coeff 1 +
        (p.coeff 1).derivative * (q.coeff 2 * Polynomial.C (2 : K)) +
        (p.coeff 0).derivative * (q.coeff 3 * Polynomial.C (3 : K)) -
      ((p.coeff 3 * Polynomial.C (3 : K)) * (q.coeff 0).derivative +
        (p.coeff 2 * Polynomial.C (2 : K)) * (q.coeff 1).derivative +
        p.coeff 1 * (q.coeff 2).derivative) = 0 := by
  have hcoeff := congrArg (fun r : K[X][Y] => r.coeff 2) hjac
  simp only [bivariateJacobian, Polynomial.coeff_sub, Polynomial.coeff_mul,
    coeff_xderiv, Polynomial.coeff_derivative, Polynomial.coeff_C,
    show (2 : ℕ) ≠ 0 by norm_num, ite_false] at hcoeff
  have hanti : (Finset.HasAntidiagonal.antidiagonal 2 :
      Finset (ℕ × ℕ)) =
      ({(0, 2), (1, 1),
        (2, 0)} : Finset (ℕ × ℕ)) := by decide
  rw [hanti] at hcoeff
  norm_num [hp, hq, Polynomial.coeff_eq_zero_of_natDegree_lt] at hcoeff ⊢
  have hC3 : Polynomial.C (3 : K) = (3 : K[X]) :=
    Polynomial.C_eq_natCast 3
  have hC2 : Polynomial.C (2 : K) = (2 : K[X]) :=
    Polynomial.C_eq_natCast 2
  rw [hC3, hC2]
  linear_combination hcoeff

