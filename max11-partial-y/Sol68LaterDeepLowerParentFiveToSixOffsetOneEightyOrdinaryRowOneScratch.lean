/-- Literal contracted source row.  It preserves the predecessor's rigid
I4 residual and appends both the new edge cubic and the exact constant-I3
equation. -/
theorem fiveToSix_offsetOneEighty_nonzero_rowOne_source_packet68
    (alpha gamma epsilon eta i4 i3 : k) (A B c d e : k[X])
    (hA : A.natDegree ≤ 4) (hB : B.natDegree ≤ 0)
    (hc : c.natDegree ≤ 2) (hd : d.natDegree ≤ 1)
    (he : e.natDegree ≤ 3)
    (ha : A.coeff 4 ≠ 0) (hb : B.coeff 0 ≠ 0)
    (hcTop : c.coeff 2 ≠ 0)
    (hx : d.coeff 1 ≠ 0) (hy : e.coeff 3 ≠ 0)
    (hface : B.coeff 0 * e.coeff 3 + c.coeff 2 * d.coeff 1 = 0)
    (hdisc : A.coeff 4 * B.coeff 0 ^ 2 + 3 * c.coeff 2 ^ 2 = 0)
    (hi4rigid : 27 * A.coeff 4 * i4 +
      32 * A.coeff 4 * B.coeff 0 ^ 3 +
        216 * d.coeff 1 * e.coeff 3 = 0)
    (hi3 : cubicFirstIntegralThreePolynomial68 0 0 gamma 0 epsilon 0
        A B c ((1 / 3 : k) • (A * B) + d) e = C i3)
    (hrowOne :
      let C0 := (1 / 3 : k) • A ^ 2 + c
      let D0 := (1 / 3 : k) • (A * B) + d
      let E0 := (1 / 27 : k) • A ^ 3 + (1 / 3 : k) • (A * c) + e
      lowerRowOnePolynomial68
        (integratedTPolynomial68 0 alpha 0 gamma epsilon A B C0 D0 E0)
        (integratedUPolynomial68 0 alpha 0 gamma 0 0 A B C0 D0 E0)
        (integratedVPolynomial68 0 alpha 0 gamma 0 epsilon eta
          A B C0 D0 E0) C0 D0 E0 = 0) :
    (27 * A.coeff 4 * i4 + 32 * A.coeff 4 * B.coeff 0 ^ 3 +
        216 * d.coeff 1 * e.coeff 3 = 0) ∧
      (9 * e.coeff 3 ^ 2 - 4 * c.coeff 2 ^ 3 = 0) ∧
      ((8 / 9 : k) *
          (-A.coeff 0 * B.coeff 0 * d.coeff 0 -
            B.coeff 0 ^ 2 * c.coeff 0 +
            3 * c.coeff 0 * e.coeff 0 +
            (3 / 2 : k) * d.coeff 0 ^ 2) +
        2 * epsilon * c.coeff 0 + 4 * gamma * e.coeff 0 -
        (2 / 3 : k) * gamma * B.coeff 0 ^ 2 = i3) := by
  let J : k[X] := secondaryResidualInvariantThreePolynomial68 A B c d e
  have hI3J : J + (2 * epsilon : k) • c +
      (4 * gamma : k) • e - (2 / 3 * gamma : k) • B ^ 2 = C i3 := by
    have hres := hi3
    rw [cubicFirstIntegralThreePolynomial68_fiveToSix_residualCoordinates]
      at hres
    simp only [zero_smul, zero_add] at hres
    simpa only [J, add_zero] using hres
  have hJdeg : J.natDegree ≤ 5 := by
    simp only [J, secondaryResidualInvariantThreePolynomial68]
    compute_degree
    omega
  have hc3 : c.coeff 3 = 0 :=
    coeff_eq_zero_of_natDegree_lt (hc.trans_lt (by norm_num))
  have hc4 : c.coeff 4 = 0 :=
    coeff_eq_zero_of_natDegree_lt (hc.trans_lt (by norm_num))
  have hc5 : c.coeff 5 = 0 :=
    coeff_eq_zero_of_natDegree_lt (hc.trans_lt (by norm_num))
  have he4 : e.coeff 4 = 0 :=
    coeff_eq_zero_of_natDegree_lt (he.trans_lt (by norm_num))
  have he5 : e.coeff 5 = 0 :=
    coeff_eq_zero_of_natDegree_lt (he.trans_lt (by norm_num))
  have hB2deg : (B ^ 2).natDegree ≤ 0 := by compute_degree; omega
  have hB2pos : ∀ j, 0 < j → (B ^ 2).coeff j = 0 := by
    intro j hj
    exact coeff_eq_zero_of_natDegree_lt (hB2deg.trans_lt hj)
  have h5 := congrArg (fun p : k[X] => p.coeff 5) hI3J
  norm_num [coeff_add, coeff_sub, coeff_smul, smul_eq_mul, coeff_C,
    hc5, he5, hB2pos 5 (by norm_num)] at h5
  have hJ5 : J.coeff 5 = 0 := h5
  have h4 := congrArg (fun p : k[X] => p.coeff 4) hI3J
  norm_num [coeff_add, coeff_sub, coeff_smul, smul_eq_mul, coeff_C,
    hc4, he4, hB2pos 4 (by norm_num)] at h4
  have hJ4 : J.coeff 4 = 0 := h4
  have h3 := congrArg (fun p : k[X] => p.coeff 3) hI3J
  norm_num [coeff_add, coeff_sub, coeff_smul, smul_eq_mul, coeff_C,
    hc3, hB2pos 3 (by norm_num)] at h3
  have hJ3 : J.coeff 3 +
      4 * gamma * e.coeff 3 = 0 := by linear_combination h3
  have hB22 : (B ^ 2).coeff 2 = 0 := hB2pos 2 (by norm_num)
  have h2 := congrArg (fun p : k[X] => p.coeff 2) hI3J
  norm_num [coeff_add, coeff_sub, coeff_smul, smul_eq_mul, coeff_C,
    hB22] at h2
  have hJ2 : J.coeff 2 +
      2 * epsilon * c.coeff 2 + 4 * gamma * e.coeff 2 = 0 := by
    linear_combination h2
  have hB20 : (B ^ 2).coeff 0 = B.coeff 0 ^ 2 := by
    simp only [pow_two, mul_coeff_zero]
  have h0 := congrArg (fun p : k[X] => p.coeff 0) hI3J
  norm_num [coeff_add, coeff_sub, coeff_smul, smul_eq_mul, coeff_C,
    hB20] at h0
  have hJ0 : J.coeff 0 = (8 / 9 : k) *
      (-A.coeff 0 * B.coeff 0 * d.coeff 0 -
        B.coeff 0 ^ 2 * c.coeff 0 + 3 * c.coeff 0 * e.coeff 0 +
        (3 / 2 : k) * d.coeff 0 ^ 2) := by
    simp only [J, secondaryResidualInvariantThreePolynomial68, coeff_add,
      coeff_sub, coeff_neg, coeff_smul,
      pow_two, mul_coeff_zero, smul_eq_mul]
    ring
  have hconstant : (8 / 9 : k) *
        (-A.coeff 0 * B.coeff 0 * d.coeff 0 -
          B.coeff 0 ^ 2 * c.coeff 0 + 3 * c.coeff 0 * e.coeff 0 +
          (3 / 2 : k) * d.coeff 0 ^ 2) +
      2 * epsilon * c.coeff 0 + 4 * gamma * e.coeff 0 -
      (2 / 3 : k) * gamma * B.coeff 0 ^ 2 = i3 := by
    rw [hJ0] at h0
    linear_combination h0
  let C0 : k[X] := (1 / 3 : k) • A ^ 2 + c
  let D0 : k[X] := (1 / 3 : k) • (A * B) + d
  let E0 : k[X] :=
    (1 / 27 : k) • A ^ 3 + (1 / 3 : k) • (A * c) + e
  change lowerRowOnePolynomial68
      (integratedTPolynomial68 0 alpha 0 gamma epsilon A B C0 D0 E0)
      (integratedUPolynomial68 0 alpha 0 gamma 0 0 A B C0 D0 E0)
      (integratedVPolynomial68 0 alpha 0 gamma 0 epsilon eta
        A B C0 D0 E0) C0 D0 E0 = 0 at hrowOne
  have hcoords := integratedPolynomial68_cubicCoordinates
    (0 : k) alpha 0 gamma 0 epsilon 0 eta A B c D0 e
  have hrowCoeff := congrArg (fun p : k[X] => p.coeff 5) hrowOne
  have hhom : cubicHomogeneousRowOnePolynomial68 A B c D0 e =
      secondaryResidualRowOnePolynomial68 A B c d e := by
    simpa only [D0] using
      cubicHomogeneousRowOnePolynomial68_residualCoordinates A B c d e
  have hres := secondaryResidualRowOnePolynomial68_coeff_five_ordinaryOneEighty68
    A B c d e hA hB hc hd he hJ5 hJ4
  have hload := cubicLoadRowOnePolynomial68_coeff_five_ordinaryOneEighty68
    alpha gamma epsilon 0 eta A B c d e hA hB hc hd he
  rw [hcoords.t_eq, hcoords.u_eq, hcoords.v_eq,
    cubicRowOnePolynomial68_split, coeff_add, hhom, hres, hload]
      at hrowCoeff
  simp only [coeff_zero] at hrowCoeff
  have hedge := fiveToSix_ordinaryOneEighty_rowOne_residual68
    (A.coeff 4) (A.coeff 3) (B.coeff 0) (c.coeff 2)
    (d.coeff 1) (e.coeff 3) (e.coeff 2) gamma epsilon
    (J.coeff 2) (J.coeff 3) hcTop hface hdisc hJ2 hJ3
    (by linear_combination hrowCoeff)
  exact ⟨hi4rigid, hedge, hconstant⟩

