    omega
  have h4 : 4 * (A.natDegree + B.natDegree + 1) ≤ 4 * D.natDegree := by
    have : A.natDegree + B.natDegree + 1 ≤ D.natDegree := by
      exact Nat.succ_le_iff.mpr href
    exact Nat.mul_le_mul_left 4 this
  omega

