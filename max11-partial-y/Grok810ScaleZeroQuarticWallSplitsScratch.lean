theorem quarticWallEmpty_BCDEG30_kappa_Zeta810
    (A B C D E F G : k[X])
    (hc : QuarticChamberBCDEG30810 A B C D E F G)
    (href : A.natDegree + B.natDegree < D.natDegree)
    (hw : 2 * C.natDegree + 2 * G.natDegree = 5 * A.natDegree) :
    False := by
  simp only [QuarticChamberBCDEG30810, QuarticRatioConeA810] at hc
  have htie : C.natDegree + G.natDegree = A.natDegree + 2 * D.natDegree := by
    omega
  have h3 : 4 * D.natDegree = 3 * A.natDegree := by
    have hL : 2 * C.natDegree + 2 * G.natDegree =
        2 * A.natDegree + 4 * D.natDegree := by
