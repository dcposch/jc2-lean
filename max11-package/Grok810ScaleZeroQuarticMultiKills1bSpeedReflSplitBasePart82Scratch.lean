  have hcf_E2 : (E ^ 2).coeff (3 * C.natDegree) =
      E.leadingCoeff ^ 2 := by
    rw [← hdeg_E2, coeff_natDegree, leadingCoeff_pow]
  rw [hcf_C3, hcf_CG, hcf_E2]
  ring


