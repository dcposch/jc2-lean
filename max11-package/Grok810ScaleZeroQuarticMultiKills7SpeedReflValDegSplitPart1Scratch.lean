  rcases hcone with ⟨hApos, hBpos, hDpos, hEpos, hFpos, hGpos, hAB, hAD, hAE, hAF, hAG, hClt⟩
  simp only [kappaQuarticFaceABDEFG810, kappaQuarticInnerABDEFG810, coeff_add, coeff_sub, coeff_smul,
